LLM_PROVIDER=groq
LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_API_KEY=gsk_replace_me
LLM_BASE_URL=https://api.groq.com/openai/v1

# Local alternative:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:3b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
REVIEW_THRESHOLD=8
OUTPUTS_DIR=outputs
